[Unit]
Description=RepoDoc AI Backend
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/repodoc-ai/backend
Environment=PORT=8000
Environment=HOST=0.0.0.0
Environment=CORS_ORIGINS=https://main.dpj4xk9u0xryq.amplifyapp.com
ExecStart=/home/ec2-user/repodoc-ai/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2 --log-level info
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=repodoc-ai

[Install]
WantedBy=multi-user.target